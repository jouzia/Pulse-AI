# Copy to .env and fill in real values for local/dev use.
# Never commit the real .env file.

ENVIRONMENT=development
API_KEY=changeme-generate-a-real-key

DATABASE_URL=postgresql+asyncpg://pulse:pulse@postgres:5432/pulse

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

RATE_LIMIT_EMAIL_PER_MINUTE=100
RATE_LIMIT_SMS_PER_MINUTE=30
RATE_LIMIT_PUSH_PER_MINUTE=200

LOG_LEVEL=INFO
